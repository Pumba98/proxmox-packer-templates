#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: ubuntu
    username: packer
    password: '$6$FhcddHFVZ7ABA4Gi$QybBjJXeTESb.NIDf7umP5rubBXM0N.SseGarXYz1kZpit8UgV6CVWo7ubIoacgdBEPUXTWXe92GyAVJ.jOJZ.'
  network:
    network:
      version: 2
      ethernets:
        ens18:
          dhcp4: true
  storage:
    layout:
      name: direct
  apt:
    # Skip subiquity's package-by-package unattended-upgrades pass (too slow), late-commands upgrade in one batch instead
    conf: |
      Unattended-Upgrade::Package-Blacklist { ".*"; };
  packages:
    - qemu-guest-agent
  ssh:
    install-server: true
  late-commands:
    - curtin in-target --target=/target -- apt-get update
    - curtin in-target --target=/target -- sh -c 'DEBIAN_FRONTEND=noninteractive apt-get -y --with-new-pkgs -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold upgrade'
    - rm -f /target/etc/apt/apt.conf.d/94curtin-config
